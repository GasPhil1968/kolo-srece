{
  "name": "povratnik",
  "private": true,
  "version": "8.0.0",
  "description": "POVRATNIK - ein stilles Point-and-Click-Abenteuer (Phaser 3 + TypeScript + Vite), ohne Ton",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/postbuild-check.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/sim/run.ts --runs 2000",
    "validate": "tsx tools/validate.ts",
    "e2e": "tsx tests/e2e/run.ts",
    "predev": "node tools/build-phaser.mjs",
    "prebuild": "node tools/build-phaser.mjs",
    "build:standalone": "vite build && node tools/build-standalone.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
